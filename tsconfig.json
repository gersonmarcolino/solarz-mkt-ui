{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["registry/solarz/ui/*"],
      "@/lib/utils": ["registry/solarz/lib/utils"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx"]
}
